# ===================================================================
# 🔑 BoneRAG Production Deployment Environment Variables
# ===================================================================

# -------------------------------------------------------------------
# 1. GitHub Repository Secrets (Settings -> Secrets -> Actions)
# -------------------------------------------------------------------
# Hugging Face Access Token with WRITE permission (get from https://huggingface.co/settings/tokens)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Hugging Face Space ID (format: username/space-name)
HF_SPACE_NAME=thanhnghidovn/boneRAG-backend

# -------------------------------------------------------------------
# 2. Vercel Frontend Environment Variables (Project Settings -> Environment Variables)
# -------------------------------------------------------------------
# URL of your deployed Hugging Face Space backend (without trailing slash)
VITE_API_BASE_URL=https://thanhnghidovn-bonerag-backend.hf.space

# -------------------------------------------------------------------
# 3. Optional Backend Analysis
# -------------------------------------------------------------------
# Used by /api/analyze-benchmark for Gemini benchmark commentary.
# If unset, the backend returns a rule-based local analysis instead.
GEMINI_API_KEY=AIza_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
